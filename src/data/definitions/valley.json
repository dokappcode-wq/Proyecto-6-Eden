  "inscriptions": [
    {
      "id": "capsule_log",
      "position": [-116, -105],
      "rotationY": 2.2,
      "yOffset": 0,
      "style": "terminal",
      "title": "Registro de la cápsula",
      "text": "Señal de la nave: perdida.\nCasco: destruido en la entrada atmosférica.\nSoporte vital: estable. Aire respirable.\nUn solo dato útil del escáner antes del impacto: estructuras artificiales activas en la superficie, emitiendo en una frecuencia azul que no reconocemos."
    },
    {
      "id": "mirador_stone",
      "position": [-66.4, -28.6],
      "rotationY": 0.8,
      "yOffset": 3.4,
      "title": "Piedra del mirador",
      "text": "«Quien sube, ve. Quien ve, elige su camino.»\nLos símbolos brillan con un azul tenue al tocarlos. Señalan hacia la torre del este."
    },
    {
      "id": "ruins_hall",
      "position": [57, 35.5],
      "rotationY": 0.5,
      "yOffset": 0,
      "title": "Sala en ruinas",
      "text": "Un mural erosionado: figuras sin rostro planean sobre un mar de nubes con alas de luz.\nBajo ellas, un valle cerrado y una piedra que guarda «las alas del primer vuelo»."
    },
    {
      "id": "tower_base",
      "position": [98, -92],
      "rotationY": -0.9,
      "yOffset": 0,
      "title": "Torre de reconocimiento",
      "text": "La estructura vibra. En su base, un grabado: «Desde lo alto, el mundo se revela».\nLa cima está demasiado alta para trepar… por ahora."
    },
    {
      "id": "temple_seal",
      "position": [114, 104],
      "rotationY": -2.3,
      "yOffset": 0,
      "title": "Piedra ancestral",
      "text": "Una piedra tallada con un portal sellado. El símbolo azul late despacio, como si esperara a alguien preparado."
    },
    {
      "id": "gate_seal",
      "position": [-7, 189],
      "rotationY": 3.14159,
      "yOffset": 0,
      "title": "Muro sellado",
      "text": "Rocas colosales cierran la salida del valle. Dos runas apagadas en su centro: una con forma de torre, otra con forma de piedra."
    }
  ],
